<?xml version="1.0" encoding="utf-8"?>
<!-- Milky launcher-icon gradient: distinct pastel cyan -> blue -> violet, with diffused light. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
 <item><shape android:shape="rectangle"><corners android:radius="24dp" />
  <gradient android:angle="315" android:centerX="0.43" android:startColor="#F3163846" android:centerColor="#F3213B60" android:endColor="#F33D2F5D" />
 </shape></item>
 <item><shape android:shape="rectangle"><corners android:radius="24dp" />
  <gradient android:type="radial" android:centerX="0.10" android:centerY="0.06" android:gradientRadius="320dp" android:startColor="#1538CDE0" android:endColor="#0038CDE0" />
 </shape></item>
 <item><shape android:shape="rectangle"><corners android:radius="24dp" />
  <gradient android:type="radial" android:centerX="0.98" android:centerY="0.85" android:gradientRadius="300dp" android:startColor="#136345D8" android:endColor="#006345D8" />
 </shape></item>
 <item><shape android:shape="rectangle"><corners android:radius="24dp" />
  <gradient android:angle="270" android:startColor="#0AFFFFFF" android:endColor="#00FFFFFF" />
  <stroke android:width="1dp" android:color="#40617A9E" />
 </shape></item>
</layer-list>
