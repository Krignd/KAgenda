<?xml version="1.0" encoding="utf-8"?>
<!-- DeepSeek 小角标（悬浮球右下角）：白底圆 + DeepSeek logo -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="0.5dp"
                android:color="#33000000" />
        </shape>
    </item>
    <item
        android:bottom="2.5dp"
        android:drawable="@drawable/ic_deepseek"
        android:left="2.5dp"
        android:right="2.5dp"
        android:top="2.5dp"
        android:tint="#4D6BFE" />
</layer-list>
