<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/overview_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="5dp" android:padding="3dp" android:background="#E8F0FF" android:orientation="vertical">
    <TextView android:id="@+id/overview_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="08:00" android:textSize="9sp" android:textColor="#1D4ED8" />
    <TextView android:id="@+id/overview_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/feature_sample_course" android:textSize="11sp" android:textColor="#0F172A" android:maxLines="4" android:ellipsize="end" />
    <TextView android:id="@+id/overview_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#64748B" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
